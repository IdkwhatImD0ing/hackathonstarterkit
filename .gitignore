# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# agent skills installed by the skills CLI (treat like node_modules).
# Our own authored skills live in the fully tracked top-level skills/ dir.
.agents/skills/
# .agents/commands/ is fully committed (all authored, no installed third-party commands)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
