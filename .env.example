# Base URL for canonical links and metadata (optional, defaults to https://thehackathonplaybook.dev)
# NEXT_PUBLIC_BASE_URL=https://thehackathonplaybook.dev

# PostHog Analytics (free tier: 1M events/month)
# Use the write-only PROJECT TOKEN (starts with phc_), NOT your personal API key (phx_)
# Find it at: https://us.posthog.com/settings/project#variables
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Beehiiv newsletter signup
BEEHIIV_PUBLICATION_ID=pub_your_publication_id_here
BEEHIIV_API_KEY=your_beehiiv_api_key_here

# ---- AI chat + embeddings (Phase 9) ----------------------------------------
# Server-side ONLY. Never prefix any of these with NEXT_PUBLIC_; the build
# runs scripts/check-client-bundle.mts and fails if a key leaks client-side.
# The site builds and runs fine with all of these absent: chat renders a
# friendly "not configured" state and MCP search falls back to lexical.
OPENAI_API_KEY=sk-your-key-here

# Chat model. Reasoning tiers (gpt-5.x, o-series) are refused at startup
# because they bill hidden reasoning tokens as output; gpt-5.6-luna is the
# one allowlisted exception (the chat route pins its reasoning effort to
# "none"). See lib/chat/config.ts before changing.
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Embedding model for scripts/build-index.mts and query embedding.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Hard monthly ceiling on total chat tokens (prompt + completion) across
# all users. Past it, /api/chat returns friendly "taking a break" copy
# until the calendar month rolls over. THE most important cost control;
# needs the Upstash KV below to hold across serverless instances.
CHAT_MONTHLY_TOKEN_BUDGET=20000000

# Per-IP request limits per 10-minute sliding window.
CHAT_RATE_LIMIT_MAX=20
MCP_RATE_LIMIT_MAX=60

# Upstash Redis (REST) for durable rate limiting + the monthly spend
# counter. Create a free database at https://console.upstash.com. Without
# these, both fall back to per-instance memory: fine for previews, not a
# real ceiling in production.
# The Vercel Marketplace "Upstash for Redis" integration injects the same
# credentials as KV_REST_API_URL / KV_REST_API_TOKEN; both namings are
# accepted (lib/redis-rest.ts), UPSTASH_* wins if both are set.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Origin lock (Phase 1.5D): set to the same random value as the Cloudflare
# Transform Rule header x-origin-verify (docs/cloudflare-config.md §6).
# Production only. Setting it without the Transform Rule 403s all traffic.
# ORIGIN_SHARED_SECRET=long-random-value

# ---- FireTrace LLM tracing -------------------------------------------------
# Every chat turn and cheat-sheet match is traced to FireTrace: retrieval,
# query embedding, the model call, token usage, and the conversation text
# itself. A thumbs up/down is recorded as a score on the rated trace.
# Absent, tracing is silently off and both routes behave exactly as before.
# Server-side ONLY; never prefix with NEXT_PUBLIC_.
# Key format: ft_live_<16 hex>_<64 hex>. Get one at https://tracing.art3m1s.me
#
# USE A SEPARATE KEY PER ENVIRONMENT. FireTrace stamps each trace with the
# environment of the key that sent it, and the request body cannot set or
# override it, so separation is only as good as the key wiring. Create one
# key per environment on the FireTrace key screen (production / preview /
# development) and set the matching value in each Vercel environment scope.
# One key shared across all three lands every trace as "unassigned" and
# mixes local traffic into production's error rate, latency, and cost.
# Filter with GET /api/v1/traces?environment=production.
FIRETRACE_API_KEY=ft_live_your_key_here

# Override only when pointing at a self-hosted or local FireTrace instance.
# FIRETRACE_BASE_URL=https://tracing.art3m1s.me

# Per-IP thumbs-up/down submissions per 10-minute sliding window.
CHAT_FEEDBACK_RATE_LIMIT_MAX=60
